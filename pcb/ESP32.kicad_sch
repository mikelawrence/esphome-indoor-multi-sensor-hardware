	)
	(text "Notes\n1. ESP32-S3 Strapping Pins: GPIO0, GPIO3, GPIO45, GPIO46.\n2. MAX98357A DAC when enabled is configured for stereo data mode.\n3. SEN0609_EN and LD24X0_EN are no longer used. In order to maintain\n   backwards compatiblity these pins should not be used.\n4. I^{2}C1 pullup is 3.4K with ESP32-s 10K pullup in parallel.\n5. I^{2}C2 pullup is 10K due to ESP32-s 10K pullup."
		(exclude_from_sim no)
		(at 20.32 171.196 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.381)
